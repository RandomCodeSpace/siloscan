<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
<appSettings>
<add key="ApiKeySettings" value="keyDerivation=Pbkdf2Sha256" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
<add key="TokenCacheProfile" value="timeout=3600000" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
</appSettings>
</configuration>
