; npm client configuration for the internal registry. Credential markers are
; replaced at run time by tests/detection_corpus.rs; see ../../README.md.
registry=https://registry.internal/repository/npm-group/
always-auth=true
_auth={{B64BASIC_20_501}}
email=ci-bot@example.com

//registry.internal/repository/npm-hosted/:_auth={{B64BASIC_28_502}}
//registry.internal/repository/npm-hosted/:username=ci-deploy
//registry.internal/repository/npm-hosted/:_password={{B64PW_24_503}}
//registry.npmjs.org/:_authToken={{NPMTOKEN_0_504}}
//staging.internal/:_auth=${NPM_STAGING_AUTH}
//mirror.internal/:_auth=<base64-of-username-and-password>
ca[]="-----BEGIN CERTIFICATE-----MIIDdzCCAl+gAwIBAgIEAgAAuTANBgkqhkiG9w0BAQUFADBaMQswCQYDVQQGEwJJRTESMBAGA1UEChMJQmFsdGltb3Jl-----END CERTIFICATE-----"
strict-ssl=true
fetch-retries=3
